{
  "name": "systemic-risk",
  "version": "2.4.2",
  "private": true,
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "dev": "npm run sync-data && next dev",
    "build": "npm run sync-data && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:cloudflare": "npm run sync-data && node scripts/build-cloudflare.mjs",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.75.5",
    "@tanstack/react-query-devtools": "^5.75.5",
    "clsx": "^2.1.1",
    "d3-dsv": "^3.0.1",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "next": "^15.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/d3-dsv": "^3.0.7",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "wrangler": "^4.148.0"
  }
}
